+// Each native IM context belongs to one editing client. Disconnect the old
+// context before focus-out: delayed provider signals cannot mutate a new field.
+static void replace_im_context(FlTextInputHandler* self) {
+  if (self->im_context != nullptr) {
+    g_signal_handlers_disconnect_by_data(self->im_context, self);
+    gtk_im_context_focus_out(self->im_context);
+    g_clear_object(&self->im_context);
+  }
+  self->im_context = GTK_IM_CONTEXT(gtk_im_multicontext_new());
+  g_object_set(self->im_context, kInputPurposeImProperty, self->im_purpose,
+               nullptr);
+  g_object_set(self->im_context, kInputHintsImProperty, self->im_hints,
+               nullptr);
+
+  // On Wayland, this call sets up the input method so it can be enabled
+  // immediately when required. Without it, on-screen keyboard's don't come up
+  // the first time a text field is focused.
+  gtk_im_context_focus_out(self->im_context);
+
+  g_signal_connect_object(self->im_context, "preedit-start",
+                          G_CALLBACK(im_preedit_start_cb), self,
+                          G_CONNECT_SWAPPED);
