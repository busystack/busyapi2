+  self->handling_key_event = TRUE;
+  self->key_context = key->context;
+  self->current_sequence = key->sequence;
+  self->current_code = fl_key_event_get_keycode(key->event);
+  self->current_state = fl_key_event_get_state(key->event);
+  self->current_press = fl_key_event_get_is_press(key->event);
