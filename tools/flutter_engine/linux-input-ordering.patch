+gboolean fl_busyapi_ime_key_forwarded(gpointer data, GdkEvent* event) {
+  auto token = static_cast<ImeKey*>(data);
+  if (token == nullptr)
+    return FALSE;
+  g_autoptr(FlView) self = FL_VIEW(g_weak_ref_get(&token->view));
+  if (self != nullptr)
+    forward_ime_event(self, token, event);
   return TRUE;
 }
 
+// Taking responsibility for the provider's native forward avoids an unowned
+// gdk_event_put after focus/client replacement. The same original event still
+// traverses GTK; its authored source and character are never synthesized here.
+gboolean fl_busyapi_ime_key_finished(gpointer data,
+                                     GdkEvent* event,
+                                     gboolean handled) {
+  auto token = static_cast<ImeKey*>(data);
+  if (token == nullptr)
+    return FALSE;
+  g_autoptr(FlView) self = FL_VIEW(g_weak_ref_get(&token->view));
+  g_weak_ref_clear(&token->view);
+  if (self != nullptr) {
+    g_assert(self->pending_ime > 0);
+    self->pending_ime--;
+    if (!handled)
+      forward_ime_event(self, token, event);
+    trace_key(self, "ime-completed", nullptr);
+    finish_key_event(self);
+  }
+  g_free(token);
+  return TRUE;
+}
