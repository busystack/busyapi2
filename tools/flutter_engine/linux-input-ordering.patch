+    fl_value_set_string_take(config, "enableDeltaModel",
+                             fl_value_new_bool(FALSE));
+    fl_value_append(args, config);
+    Method("TextInput.setClient", args);
+  }
+  void SetState(const char* text) {
+    g_autoptr(FlValue) args = fl_value_new_map();
+    fl_value_set_string_take(args, "text", fl_value_new_string(text));
+    fl_value_set_string_take(args, "selectionBase",
+                             fl_value_new_int(strlen(text)));
+    fl_value_set_string_take(args, "selectionExtent",
+                             fl_value_new_int(strlen(text)));
+    fl_value_set_string_take(args, "composingBase", fl_value_new_int(-1));
+    fl_value_set_string_take(args, "composingExtent", fl_value_new_int(-1));
+    Method("TextInput.setEditingState", args);
+  }
+  void Send(guint value, guint code, bool press) {
+    g_autoptr(GdkEvent) event =
+        gdk_event_new(press ? GDK_KEY_PRESS : GDK_KEY_RELEASE);
+    event->key.keyval = value;
+    event->key.hardware_keycode = code;
+    auto widget = GTK_WIDGET(view);
+    auto klass = GTK_WIDGET_GET_CLASS(widget);
+    EXPECT_TRUE(press ? klass->key_press_event(widget, &event->key)
+                      : klass->key_release_event(widget, &event->key));
+  }
+  void ApplyReply() {
+    ASSERT_NE(editing_reply, nullptr);
+    framework_text = pending_text;
+    order.push_back("editing-applied");
+    g_autoptr(FlJsonMethodCodec) codec = fl_json_method_codec_new();
+    g_autoptr(GBytes) envelope = fl_method_codec_encode_success_envelope(
+        FL_METHOD_CODEC(codec), nullptr, nullptr);
+    g_task_return_pointer(editing_reply, g_bytes_ref(envelope),
+                          reinterpret_cast<GDestroyNotify>(g_bytes_unref));
+    g_clear_object(&editing_reply);
+    Drain();
+  }
+};
