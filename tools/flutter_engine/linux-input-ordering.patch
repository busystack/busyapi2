+// The CPU handoff must preserve premultiplied channels, GL's bottom-up origin,
+// the caller's Cairo state/clip, and avoid recreating a GL texture during draw.
+TEST_F(FlCompositorOpenGLTest, CpuFramePixelsAndCairoState) {
+  PresentPixels(
+      2, 2, {0, 0, 255, 255, 64, 32, 16, 128, 255, 0, 0, 255, 0, 255, 0, 255});
+  cairo_surface_t* image =
+      cairo_image_surface_create(CAIRO_FORMAT_ARGB32, 4, 4);
+  cairo_t* cr = cairo_create(image);
+  cairo_set_source_rgb(cr, 1, 1, 1);
+  cairo_paint(cr);
+  cairo_translate(cr, 1, 1);
+  cairo_rectangle(cr, 0, 0, 2, 2);
+  cairo_clip(cr);
+  cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+  EXPECT_CALL(epoxy, glGenTextures).Times(0);
+  // This draw can run without any current GTK GL context.
+  EXPECT_CALL(epoxy, glFlush).Times(0);
+  EXPECT_TRUE(
+      fl_compositor_render(FL_COMPOSITOR(compositor), cr, nullptr, FALSE));
+  EXPECT_EQ(cairo_get_operator(cr), CAIRO_OPERATOR_SOURCE);
+  cairo_matrix_t matrix;
+  cairo_get_matrix(cr, &matrix);
+  EXPECT_EQ(matrix.xx, 1);
+  EXPECT_EQ(matrix.yy, 1);
+  EXPECT_EQ(matrix.x0, 1);
+  EXPECT_EQ(matrix.y0, 1);
+  EXPECT_EQ(Pixel(image, 1, 1), 0xffff0000u);
+  EXPECT_EQ(Pixel(image, 2, 1), 0xff00ff00u);
+  EXPECT_EQ(Pixel(image, 1, 2), 0xff0000ffu);
+  EXPECT_EQ(Pixel(image, 2, 2), 0xffbf9f8fu);
+  EXPECT_EQ(Pixel(image, 0, 0), 0xffffffffu);
+  cairo_destroy(cr);
+  cairo_surface_destroy(image);
+}
+
