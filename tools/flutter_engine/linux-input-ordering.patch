+  if (self->input_closed || self->key_events == nullptr)
+    return;
+  PendingKey* key = g_new0(PendingKey, 1);
+  key->event = fl_key_event_new_from_gdk_event(gdk_event_copy(event));
+  key->before_gtk = TRUE;
+  key->context = fl_text_input_handler_get_context(
+      fl_engine_get_text_input_handler(self->engine));
+  key->queued_at = g_get_monotonic_time();
+  key->sequence = ++self->sequence;
+  g_queue_push_tail(self->key_events, key);
+  trace_key(self, "queued-before-gtk", key);
+  dispatch_next_key_event(self);
+}
