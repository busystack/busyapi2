+  EXPECT_EQ(Pixel(image, 2, 2), 0xffffffffu);
+  EXPECT_EQ(Pixel(image, 3, 3), 0xffffffffu);
+  EXPECT_EQ(Pixel(image, 0, 0), 0u);
+  EXPECT_EQ(Pixel(image, 5, 5), 0u);
+  cairo_destroy(cr);
+  cairo_surface_destroy(image);
+}
+
+TEST_F(FlCompositorOpenGLTest, CpuFrameRecordingRetainsOldPixelsAcrossResize) {
+  PresentPixels(1, 1, {255, 0, 0, 255});
+  cairo_surface_t* recording =
+      cairo_recording_surface_create(CAIRO_CONTENT_COLOR_ALPHA, nullptr);
+  cairo_t* cr = cairo_create(recording);
+  EXPECT_TRUE(
+      fl_compositor_render(FL_COMPOSITOR(compositor), cr, nullptr, FALSE));
+  cairo_destroy(cr);
+  PresentPixels(
+      2, 2, {0, 0, 255, 255, 0, 0, 255, 255, 0, 0, 255, 255, 0, 0, 255, 255});
+  cairo_surface_t* image =
+      cairo_image_surface_create(CAIRO_FORMAT_ARGB32, 2, 2);
+  cr = cairo_create(image);
+  cairo_set_source_surface(cr, recording, 0, 0);
+  cairo_paint(cr);
+  EXPECT_EQ(Pixel(image, 0, 0), 0xffff0000u);
+  EXPECT_EQ(Pixel(image, 1, 1), 0u);
+  cairo_destroy(cr);
+  cairo_surface_destroy(recording);
+  cr = cairo_create(image);
+  EXPECT_TRUE(
+      fl_compositor_render(FL_COMPOSITOR(compositor), cr, nullptr, FALSE));
+  EXPECT_EQ(Pixel(image, 0, 0), 0xff0000ffu);
+  EXPECT_EQ(Pixel(image, 1, 1), 0xff0000ffu);
+  cairo_destroy(cr);
+  cairo_surface_destroy(image);
+}
