+static gboolean handle_key_event(FlView* self, GdkEventKey* key_event) {
+  if (self->input_closed || self->key_events == nullptr)
+    return TRUE;
+  if (self->processing_gtk) {
+    self->framework_dispatched = TRUE;
+    g_autoptr(FlKeyEvent) event = fl_key_event_new_from_gdk_event(
+        gdk_event_copy(reinterpret_cast<GdkEvent*>(key_event)));
+    dispatch_key_to_framework(self, event);
+    return TRUE;
+  }
+  PendingKey* key = g_new0(PendingKey, 1);
+  key->event = fl_key_event_new_from_gdk_event(
+      gdk_event_copy(reinterpret_cast<GdkEvent*>(key_event)));
+  key->context = fl_text_input_handler_get_context(
+      fl_engine_get_text_input_handler(self->engine));
+  key->queued_at = g_get_monotonic_time();
+  key->sequence = ++self->sequence;
+  g_queue_push_tail(self->key_events, key);
+  trace_key(self, "queued", key);
+  dispatch_next_key_event(self);
+  return TRUE;
+}
 
+static void cancel_queued_keys(FlView* self) {
+  if (self->key_events == nullptr)
+    return;
+  while (!g_queue_is_empty(self->key_events)) {
+    PendingKey* key =
+        static_cast<PendingKey*>(g_queue_pop_head(self->key_events));
+    gpointer code = GUINT_TO_POINTER(fl_key_event_get_keycode(key->event));
+    if (self->engine != nullptr && self->dispatched_keys != nullptr &&
+        !fl_key_event_get_is_press(key->event) &&
+        g_hash_table_remove(self->dispatched_keys, code)) {
+      // An original queued release balances a down already sent to the
+      // framework. It cannot run text fallback against a replacement client.
+      trace_key(self, "shutdown-release", key);
+      fl_keyboard_manager_handle_event(
+          fl_engine_get_keyboard_manager(self->engine), key->event, nullptr,
+          nullptr, nullptr);
+    } else {
+      trace_key(self, "owner-cancelled", key);
+    }
+    pending_key_free(key);
+  }
+}
+
+static void input_destroy_cb(FlView* self) {
+  self->input_closed = TRUE;
+  cancel_queued_keys(self);
+  if (self->cancellable != nullptr)
+    g_cancellable_cancel(self->cancellable);
+}
