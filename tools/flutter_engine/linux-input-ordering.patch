+static FlView* focused_view_for_event(GdkEvent* event) {
+  GtkWidget* widget = gtk_get_event_widget(event);
+  GtkWidget* top = widget ? gtk_widget_get_toplevel(widget) : nullptr;
+  GtkWidget* focus = top && GTK_IS_WINDOW(top)
+                         ? gtk_window_get_focus(GTK_WINDOW(top))
+                         : nullptr;
+  while (focus != nullptr && !FL_IS_VIEW(focus))
+    focus = gtk_widget_get_parent(focus);
+  return focus != nullptr ? FL_VIEW(focus) : nullptr;
+}
+
+gpointer fl_busyapi_ime_key_started(GdkEvent* event) {
+  FlView* view = focused_view_for_event(event);
+  return view != nullptr ? fl_view_begin_ime_key(view, event) : nullptr;
+}
+
+static void ordered_gdk_event(GdkEvent* event, gpointer) {
+  if (event->type == GDK_KEY_PRESS || event->type == GDK_KEY_RELEASE) {
+    FlView* focus = focused_view_for_event(event);
+    if (focus != nullptr) {
+      g_autoptr(FlView) view = FL_VIEW(g_object_ref(focus));
+      fl_view_enqueue_key_before_gtk(view, event);
+      return;
+    }
+  }
+  gtk_main_do_event(event);
+}
