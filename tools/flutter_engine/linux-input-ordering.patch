+// An input provider retains this token across its actual asynchronous work.
+// It is not an expectation that every key emits text: handled modifiers,
+// dead keys, releases and intermediate composition complete through the same
+// API.
+gpointer fl_view_begin_ime_key(FlView* self, GdkEvent*) {
+  if (self->input_closed || !self->handling_key_event)
+    return nullptr;
+  auto token = g_new0(ImeKey, 1);
+  g_weak_ref_init(&token->view, self);
+  token->context = self->key_context;
+  token->sequence = self->current_sequence;
+  token->queued_at = self->current_queued_at;
+  token->after_framework = self->framework_dispatched;
+  self->pending_ime++;
+  trace_key(self, "ime-started", nullptr);
+  return token;
+}
+
+// ForwardKeyEvent signals may precede the final asynchronous provider reply.
+// They retain the request's captured owner and do not release its in-flight
+// guard. The provider's native event still runs GTK's existing fallback.
+static void forward_ime_event(FlView* self, ImeKey* token, GdkEvent* event) {
+  const bool current =
+      !self->input_closed && self->engine != nullptr &&
+      token->context == fl_text_input_handler_get_context(
+                            fl_engine_get_text_input_handler(self->engine));
+  // A physical release for a down already delivered still balances global
+  // keyboard state after focus changes. It must skip GTK/text fallback.
+  const bool balance_release =
+      !self->input_closed && self->engine != nullptr &&
+      event->type == GDK_KEY_RELEASE &&
+      g_hash_table_contains(self->dispatched_keys,
+                            GUINT_TO_POINTER(event->key.hardware_keycode));
+  if (current || balance_release) {
+    PendingKey* key = g_new0(PendingKey, 1);
+    key->event = fl_key_event_new_from_gdk_event(gdk_event_copy(event));
+    key->before_gtk = current;
+    key->context = token->context;
+    key->sequence = token->sequence;
+    key->queued_at = token->queued_at;
+    bool enqueue = true;
+    if (token->after_framework) {
+      // The framework already declined this key. Let the provider process
+      // its completed native forward, without sending the key to Dart twice.
+      const gboolean was_processing = self->processing_gtk;
+      self->processing_gtk = TRUE;
+      enqueue = !fl_text_input_handler_filter_keypress(
+          fl_engine_get_text_input_handler(self->engine), key->event);
+      self->processing_gtk = was_processing;
+      if (enqueue) {
+        fl_keyboard_manager_add_redispatched_event(
+            fl_engine_get_keyboard_manager(self->engine), key->event);
+      }
+    }
+    if (enqueue) {
+      // Provider forwards belong before later physical keys, preserving the
+      // order of multiple forwards emitted by the same original key.
+      GList* next = self->key_events->head;
+      while (next != nullptr &&
+             static_cast<PendingKey*>(next->data)->sequence <= key->sequence)
+        next = next->next;
+      g_queue_insert_before(self->key_events, next, key);
+      trace_key(self, "ime-forward-owned", key);
+    } else {
+      pending_key_free(key);
+    }
+  } else if (!current) {
+    trace_key(self, "ime-owner-cancelled", nullptr);
+  }
+}
