+                                                    &event->key);
+      });
+  ON_CALL(gtk, gtk_im_context_filter_keypress(::testing::_, ::testing::_))
+      .WillByDefault([](GtkIMContext* context, GdkEventKey* event) {
+        if (event->keyval == GDK_KEY_x || event->keyval == GDK_KEY_y) {
+          const gchar text[] = {static_cast<gchar>(event->keyval), 0};
+          g_signal_emit_by_name(context, "commit", text);
+        }
+        return TRUE;
+      });
+  g_autoptr(GdkEvent) first = gdk_event_new(GDK_KEY_PRESS);
+  first->key.keyval = GDK_KEY_x;
+  first->key.hardware_keycode = 53;
+  fl_view_enqueue_key_before_gtk(view, first);
+  Send(GDK_KEY_BackSpace, 22, true);
+  Drain();
+  ASSERT_NE(completion, nullptr);
+  g_autoptr(GdkEvent) a = gdk_event_copy(first);
+  a->key.state |= (1u << 25);
+  g_autoptr(GdkEvent) b = gdk_event_copy(a);
+  b->key.keyval = GDK_KEY_y;
+  b->key.hardware_keycode = 29;
+  EXPECT_TRUE(fl_busyapi_ime_key_forwarded(completion, a));
+  EXPECT_TRUE(fl_busyapi_ime_key_forwarded(completion, b));
+  Drain();
+  EXPECT_TRUE(forwarded.empty());  // Neither signal completes the request.
+  EXPECT_TRUE(fl_busyapi_ime_key_finished(completion, first, TRUE));
+  Drain();
+  ASSERT_NE(editing_reply, nullptr);
+  ApplyReply();
+  ASSERT_NE(editing_reply, nullptr);
+  ApplyReply();
+  EXPECT_EQ(forwarded, (std::vector<guint>{GDK_KEY_x, GDK_KEY_y}));
+  EXPECT_EQ(framework_text, "ABx");  // x, y, then the physical Backspace.
+}
+
+TEST_F(FlViewOrderingTest, ExplicitImeSignalCannotFollowAReplacedInputClient) {
+  gpointer completion = nullptr;
+  ON_CALL(gtk, gtk_main_do_event(::testing::_))
+      .WillByDefault([this, &completion](GdkEvent* event) {
+        completion = fl_view_begin_ime_key(view, event);
+      });
+  g_autoptr(GdkEvent) first = gdk_event_new(GDK_KEY_PRESS);
+  first->key.keyval = GDK_KEY_x;
+  first->key.hardware_keycode = 53;
+  fl_view_enqueue_key_before_gtk(view, first);
+  Drain();
+  SetClient(2);
+  SetState("Other");
+  framework_text = "Other";
+  EXPECT_TRUE(fl_busyapi_ime_key_forwarded(completion, first));
+  EXPECT_TRUE(fl_busyapi_ime_key_finished(completion, first, TRUE));
+  Drain();
+  EXPECT_EQ(raw_count, 0u);
+  EXPECT_EQ(framework_text, "Other");
+  EXPECT_EQ(editing_reply, nullptr);
+}
