+/* BusyAPI-only optional completion bridge. The stock module has no observers.
+ * Tokens capture the original Flutter input owner. Completion means the IBus
+ * reply has arrived, including no-text keys; Flutter separately acknowledges
+ * every editing-state message before it releases its native key queue. */
+typedef gpointer (*BusyApiKeyStarted) (GdkEvent *event);
+typedef gboolean (*BusyApiKeyFinished) (gpointer token, GdkEvent *event,
+                                       gboolean handled);
+typedef gboolean (*BusyApiKeyForwarded) (gpointer token, GdkEvent *event);
+static BusyApiKeyStarted busyapi_started;
+static BusyApiKeyFinished busyapi_finished;
+static BusyApiKeyForwarded busyapi_forwarded;
+static GHashTable *busyapi_queued;
+
+typedef struct {
+    gpointer token;
+    BusyApiKeyFinished finished;
+} BusyApiQueuedKey;
+
+G_MODULE_EXPORT guint
+busyapi_ibus_completion_abi (void)
+{
+    return 1;
+}
+
+G_MODULE_EXPORT void
+busyapi_ibus_set_key_completion (BusyApiKeyStarted started,
+                                 BusyApiKeyFinished finished,
+                                 BusyApiKeyForwarded forwarded)
+{
+    g_return_if_fail (started && finished && forwarded);
+    g_return_if_fail (!busyapi_started);
+    busyapi_started = started;
+    busyapi_finished = finished;
+    busyapi_forwarded = forwarded;
+    busyapi_queued = g_hash_table_new (g_direct_hash, g_direct_equal);
+}
+
+static void
+busyapi_queue_event (GdkEvent *event)
+{
+    gpointer token;
+    BusyApiQueuedKey *key;
+    if (!busyapi_started || !(token = busyapi_started (event)))
+        return;
+    key = g_new0 (BusyApiQueuedKey, 1);
+    key->token = token;
+    key->finished = busyapi_finished;
+    g_hash_table_insert (busyapi_queued, event, key);
+}
+
+static gboolean
+busyapi_finish_queued (GdkEvent *event, gboolean handled)
+{
+    BusyApiQueuedKey *key = busyapi_queued ?
+            g_hash_table_lookup (busyapi_queued, event) : NULL;
+    gboolean owned = FALSE;
+    if (key) {
+        g_hash_table_steal (busyapi_queued, event);
+        owned = key->finished (key->token, event, handled);
+        g_free (key);
+    }
+    return owned;
+}
+
+static void
+busyapi_free_queued (GdkEvent *event)
+{
+    /* Destruction cancels this captured owner; never forward into a new field. */
+    busyapi_finish_queued (event, TRUE);
+#if GTK_CHECK_VERSION (3, 98, 4)
+    gdk_event_unref (event);
+#else
+    gdk_event_free (event);
+#endif
+}
+
